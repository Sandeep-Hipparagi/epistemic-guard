# ==============================================================================
# Epistemic Guard Environment Configuration
# ==============================================================================

# Execution Environment: development | testing | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Model-Agnostic LLM Provider Settings (OpenAI-Compatible Spec)
# Works out-of-the-box with local endpoints (Ollama, vLLM, llama.cpp, LocalAI)
# as well as cloud providers (OpenAI, Groq, Mistral, Together, etc.).
# ------------------------------------------------------------------------------
# Local Ollama default: http://localhost:11434/v1
# Local vLLM default:   http://localhost:8000/v1
# Local llama.cpp:      http://localhost:8080/v1
# Cloud OpenAI default: https://api.openai.com/v1
OPENAI_BASE_URL=http://localhost:11434/v1

# API Key: For local inference (Ollama / llama.cpp), use "dummy-local-key"
# For cloud providers, supply your real API key
OPENAI_API_KEY=dummy-local-key

# Target model identifier (e.g. llama3.2, mistral, gpt-4o-mini, qwen2.5)
OPENAI_MODEL_NAME=llama3.2

# Inference parameters
REQUEST_TIMEOUT=30.0
TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# Provenance Auditing Engine Settings
# ------------------------------------------------------------------------------
# Path to source tiering rules definition
SOURCE_TIERS_CONFIG_PATH=config/source_tiers.yaml

# Behavioral strictness toggles
STRICT_TIMESTAMP_ENFORCEMENT=true
REQUIRE_PRIMARY_EVIDENCE_FOR_BREAKING=true
